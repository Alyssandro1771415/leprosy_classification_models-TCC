FROM python:3.12-slim-bookworm

# 1. Instalar dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. Instalar o uv
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin/:$PATH"

WORKDIR /app

# 3. Corrigindo o erro de cópia (Adicionando a / no final)
# O caminho aqui assume que você seguiu a estratégia de Root Directory Vazio
COPY APP/Leprosy-Identifier\ -\ Back-End/pyproject.toml APP/Leprosy-Identifier\ -\ Back-End/uv.lock ./

# 4. Instalar dependências
# Nota: O TensorFlow é gigante. Se o build falhar por falta de espaço ou memória,
# você terá que considerar o TensorFlow-cpu para economizar recursos.
RUN uv sync --frozen

# 5. Copiar o conteúdo do back-end para a raiz do WORKDIR (/app)
COPY APP/Leprosy-Identifier\ -\ Back-End/pyproject.toml APP/Leprosy-Identifier\ -\ Back-End/uv.lock ./

# 6. Configurar ambiente
ENV PYTHONPATH="/app"
ENV PATH="/app/.venv/bin:$PATH"

# Garante que o Robyn use a porta do Render
ENV ROBYN_PORT=$PORT

# 7. Execução
# Usamos apenas 1 worker devido ao limite de CPU/RAM do plano Free do Render
CMD ["python", "server.py"]