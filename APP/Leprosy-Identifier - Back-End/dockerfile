FROM python:3.12-slim-bookworm

# 1. Instalar dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. Instalar o uv
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh
ENV PATH="/root/.local/bin/:$PATH"

# 3. Configurar diretório de trabalho dentro do container
WORKDIR /app

# 4. Copiar dependências
# Como o Root Directory do Render já é a pasta do Back-End,
# estes ficheiros estão na "raiz" do contexto de build.
COPY pyproject.toml uv.lock ./

# 5. Instalar dependências usando o uv
RUN uv sync --frozen

# 6. Copiar o restante do código (server.py, pasta src, etc)
COPY . .

# 7. Configurações de ambiente para o Robyn e Python
ENV PYTHONPATH="/app"
ENV PATH="/app/.venv/bin:$PATH"
# Garante que o Robyn use a porta que o Render fornecer
ENV ROBYN_PORT=$PORT

# 8. Execução
# Removi o --processes e --workers fixos para o plano gratuito não estourar CPU
# O Render injeta a porta automaticamente na variável $PORT
CMD ["python", "server.py"]