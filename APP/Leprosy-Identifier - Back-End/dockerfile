FROM python:3.12-slim-bookworm

# 1. Instalar dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates

# 2. Instalar o uv de forma direta e garantir que ele esteja no PATH
# Usar a imagem oficial do uv como builder é mais limpo, mas mantendo seu estilo:
ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh

# O uv é instalado em /root/.local/bin por padrão
ENV PATH="/root/.local/bin/:$PATH"

# 3. Configurar diretório de trabalho
WORKDIR /app

# 4. Copiar apenas os arquivos de dependências primeiro (otimiza cache do Docker)
COPY pyproject.toml uv.lock ./

# ... (mantenha o início igual)

# 5. Instalar dependências
RUN uv sync --frozen

# 6. Copiar o restante do código
COPY . .

# --- ADICIONE ESTA LINHA AQUI ---
ENV PYTHONPATH="/app/.venv/lib/python3.12/site-packages"
# -------------------------------

# 7. Garantir que o ambiente virtual seja usado para executáveis
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 5000

CMD ["python", "server.py", "--processes", "2", "--workers", "4"]